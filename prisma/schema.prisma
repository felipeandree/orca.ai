generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Company {
  id                  String   @id @default(cuid())
  name                String
  email               String   @unique
  passwordHash        String
  phone               String   @default("")
  document            String   @default("")
  address             String   @default("")
  specialty           String   @default("Prestador de Serviços")
  primaryColor        String   @default("#2563eb")
  pixKey              String   @default("")
  logoUrl             String   @default("")
  defaultValidDays    Int      @default(7)
  defaultFollowUpDays Int      @default(2)
  defaultNotes        String   @default("Pagamento: 50% de entrada e 50% na conclusão do serviço (PIX ou Cartão).\nGarantia de 90 dias sobre a mão de obra.")
  isAdmin             Boolean  @default(false)
  planStatus          String   @default("ACTIVE") // ACTIVE | TRIAL | BLOCKED
  monthlyFee          Float    @default(97.0)
  setupFee            Float    @default(297.0)
  dueDay              Int      @default(10)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  clients      Client[]
  quotes       Quote[]
  catalogItems CatalogItem[]
}

model Client {
  id        String   @id @default(cuid())
  companyId String
  name      String
  phone     String
  email     String   @default("")
  address   String   @default("")
  notes     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  quotes  Quote[]

  @@index([companyId])
}

model CatalogItem {
  id          String   @id @default(cuid())
  companyId   String
  description String
  type        String   @default("SERVICE") // SERVICE | MATERIAL
  unitPrice   Float    @default(0)
  unit        String   @default("un")
  createdAt   DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model Quote {
  id             String    @id @default(cuid())
  number         Int
  companyId      String
  clientId       String
  title          String
  status         String    @default("NEW") // NEW | SENT | APPROVED | COMPLETED | REJECTED
  subtotal       Float     @default(0)
  discount       Float     @default(0)
  total          Float     @default(0)
  validDays      Int       @default(7)
  followUpDate   DateTime?
  followUpDone   Boolean   @default(false)
  lastContactAt  DateTime?
  notes          String    @default("")
  internalNotes  String    @default("")
  sentAt         DateTime?
  approvedAt     DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client  Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  items   QuoteItem[]

  @@index([companyId])
  @@index([clientId])
}

model QuoteItem {
  id          String @id @default(cuid())
  quoteId     String
  description String
  type        String @default("SERVICE") // SERVICE | MATERIAL
  quantity    Float  @default(1)
  unitPrice   Float  @default(0)
  total       Float  @default(0)

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
}
